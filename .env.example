# Copy this file to .env and fill in your values

# Django REST Framework backend base URL
VITE_API_BASE_URL=http://localhost:8000

# Root domain of the platform (used by TenantGuard to redirect invalid subdomains)
VITE_ROOT_DOMAIN=http://localhost:5173

# Set to "true" to enable MSW mock API in development (no real backend needed)
# Set to "false" or remove when a real backend is available
VITE_USE_MOCKS=true
